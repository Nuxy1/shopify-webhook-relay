# Copy to .env and fill in. Never commit .env.
PORT=3000
# Shopify admin > Settings > Notifications > Webhooks: the secret shown under the webhook list
SHOPIFY_WEBHOOK_SECRET=dev-secret
# Google Sheets (optional): the spreadsheet id from its URL, the tab and cell to append from, and the service
# account key (a file path or the JSON itself). Share the sheet with the key's client_email as an Editor.
SHEET_ID=
SHEET_RANGE=Orders!A1
GOOGLE_SERVICE_ACCOUNT=
# Discord or Slack incoming webhook URL (optional)
NOTIFY_WEBHOOK_URL=
# Local CSV backup ("off" to disable), failed deliveries, and the country code for 10-digit phone numbers
CSV_PATH=data/orders.csv
DEAD_LETTER_PATH=data/dead-letters.jsonl
DEFAULT_COUNTRY_CODE=1
